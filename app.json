{
  "expo": {
    "name": "EOS",
    "slug": "sece",
    "scheme": "eos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eos.mobileapp"
    },
    "android": {
      "package": "com.eos.mobileapp",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "notification": {
      "icon": "./src/features/amenity/craveo/app/assets/icon.png",
      "color": "#FF4444",
      "androidMode": "default",
      "androidCollapsedTitle": "Food Ready Alert"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "EOS needs camera access to scan a wallet QR code when sending money."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/features/amenity/craveo/app/assets/icon.png",
          "color": "#FF4444",
          "defaultChannel": "alarm-channel"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "147d471c-0441-4b94-b706-4d7aa78b2f87"
      }
    },
    "owner": "eos-seces-team"
  }
}
