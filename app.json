{
  "expo": {
    "name": "EOS",
    "slug": "sece",
    "scheme": "eos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eos.mobileapp",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "EOS needs microphone access so you can speak during an online class."
      }
    },
    "android": {
      "package": "com.eos.mobileapp",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "notification": {
      "icon": "./assets/icons/icon.png",
      "color": "#FF4444",
      "androidMode": "default",
      "androidCollapsedTitle": "Food Ready Alert"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "EOS needs camera access to scan a wallet QR code when sending money, and to show your video during an online class."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/icon.png",
          "color": "#FF4444",
          "defaultChannel": "alarm-channel"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3aed3a9a-76e4-40ee-a483-4bb0d589f33e"
      }
    },
    "owner": "shonab"
  }
}
