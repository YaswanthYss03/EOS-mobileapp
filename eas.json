{
  "cli": {
    "version": ">= 21.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://eosbackend1.onrender.com/api/v1",
        "EXPO_PUBLIC_API_BASE_URL": "https://restaurent-app-9lnh.onrender.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://eosbackend1.onrender.com/api/v1",
        "EXPO_PUBLIC_API_BASE_URL": "https://restaurent-app-9lnh.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
